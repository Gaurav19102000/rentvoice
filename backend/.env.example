# ---------- Core ----------
DATABASE_URL=sqlite:///./rentvoice.db
# For Postgres (Neon / Supabase / local): postgresql+psycopg2://user:pass@host:5432/rentvoice
FRONTEND_URL=http://localhost:5173
PUBLIC_BACKEND_URL=https://your-ngrok-url.ngrok-free.app   # Vapi must reach this
ADMIN_TOKEN=change-me
DEMO_MODE=true          # enables the "simulate call" panel (no Vapi credits needed)
LISTING_TTL_DAYS=30     # listings not re-verified within this many days are hidden

# ---------- Vapi (voice agent) ----------
VAPI_API_KEY=            # private key (server only)
VAPI_PUBLIC_KEY=         # public key (safe for browser web calls)
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=    # needed only for real outbound phone calls
VAPI_WEBHOOK_SECRET=     # same secret you set on the Server URL in Vapi

# ---------- LLM for the chatbot (optional; rule-based fallback if empty) ----------
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

# ---------- SMS link after call (optional) ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
